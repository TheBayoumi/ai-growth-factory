# AI Growth Factory 1.4.0 — free-first cloud configuration

# -----------------------------------------------------------------------------
# Activation and publication safety
# -----------------------------------------------------------------------------
PUBLISH_ENABLED=false
REVIEWER_REQUIRED=true
REVIEWER_BACKEND=qwen_omni
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_OAUTH_JSON=

# Optional paid reviewer upgrade. Not required during the proof stage.
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-realtime-2.1
OPENAI_REVIEW_REASONING=medium

# -----------------------------------------------------------------------------
# Open-weight script model: llama.cpp + Qwen3-4B GGUF
# -----------------------------------------------------------------------------
LLAMA_CPP_MANAGED=true
LLAMA_CPP_EXECUTABLE=llama-server
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_HF_MODEL=Qwen/Qwen3-4B-GGUF:Q4_K_M
LLAMA_CPP_MODEL=Qwen3-4B-Q4_K_M.gguf
LLAMA_CPP_CONTEXT_TOKENS=16384
LLAMA_CPP_GPU_LAYERS=99
LLAMA_CPP_TIMEOUT_SECONDS=240
LLAMA_CPP_STARTUP_TIMEOUT_SECONDS=240
LLAMA_CPP_TEMPERATURE=0.45

# -----------------------------------------------------------------------------
# ViMax Script2Video planning (isolated subprocess, pinned commit)
# -----------------------------------------------------------------------------
# Disabled until the pinned ViMax environment has been installed and validated.
VIMAX_PLANNER_ENABLED=false
VIMAX_ROOT=/opt/vimax
VIMAX_PYTHON=/opt/vimax/.venv/bin/python
VIMAX_PLANNER_SCRIPT=
VIMAX_PLANNER_TIMEOUT_SECONDS=900
VIMAX_LLM_API_KEY=not-needed

# -----------------------------------------------------------------------------
# Final compositor
# -----------------------------------------------------------------------------
# Keep ffmpeg for A/B rollback. Set to remotion only after `renderer` is built.
VIDEO_RENDER_BACKEND=ffmpeg
REMOTION_RENDERER_DIR=/opt/ai-growth-factory/renderer
REMOTION_CONCURRENCY=50%

# -----------------------------------------------------------------------------
# Open-weight narration generator: Qwen3-TTS
# -----------------------------------------------------------------------------
TTS_BACKEND=qwen3
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_MODE=custom_voice
QWEN_TTS_SPEAKER=Ryan
QWEN_TTS_LANGUAGE=English
QWEN_TTS_DEVICE=cuda:0
QWEN_TTS_DTYPE=float16
QWEN_TTS_ATTENTION=sdpa

# Voice-clone mode must use an audio recording you own or are authorized to use.
# QWEN_TTS_MODE=voice_clone
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# QWEN_REF_AUDIO=/path/to/authorized-reference.wav
# QWEN_REF_TEXT=Exact transcript of the reference recording.

VOICE_CONTRACT_FILE=voice_contract.json

# -----------------------------------------------------------------------------
# Open-weight audio reviewer: Qwen2.5-Omni GPTQ Int4
# -----------------------------------------------------------------------------
QWEN_OMNI_REVIEW_MODEL=Qwen/Qwen2.5-Omni-7B-GPTQ-Int4
QWEN_OMNI_DEVICE=cuda:0
QWEN_OMNI_DTYPE=float16
QWEN_OMNI_ATTENTION=sdpa
QWEN_OMNI_MAX_NEW_TOKENS=900
VOICE_REVIEW_MAX_ATTEMPTS=3
VOICE_REVIEW_TIMEOUT_SECONDS=180

# Objective and locally enforced publication thresholds.
AUDIO_TARGET_LUFS=-16
AUDIO_PEAK_LIMIT_DBFS=-1
AUDIO_MIN_RMS_DBFS=-32
AUDIO_MAX_CLIPPING_RATIO=0.0005
AUDIO_MAX_SILENCE_RATIO=0.28
AUDIO_MAX_SILENCE_SECONDS=1.25
AUDIO_WPM_TOLERANCE=32
AUDIO_SEGMENT_PAUSE_MS=140
NARRATION_SEGMENTS=6
REVIEW_OVERALL_THRESHOLD=0.87
REVIEW_FIDELITY_THRESHOLD=0.98
REVIEW_NATURALNESS_THRESHOLD=0.85
REVIEW_PRONUNCIATION_THRESHOLD=0.92

# -----------------------------------------------------------------------------
# Channel and growth settings
# -----------------------------------------------------------------------------
CHANNEL_LANGUAGE=en
CHANNEL_REGION=EG
TIMEZONE_NAME=Africa/Cairo
TARGET_SECONDS=62
MAX_RECENT_VIDEOS=30
MIN_PRIMARY_SOURCES=2
MAX_SOURCE_AGE_HOURS=48
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=24

# Optional owner-controlled monetization destination.
MONETIZATION_URL=
MONETIZATION_LABEL=Get the full implementation

# Modal overrides these with persistent mounted paths.
WORK_ROOT=./work
STATE_ROOT=./state

# Optional control endpoint secrets.
CRON_SECRET=
FACTORY_SECRET=
